# Entra ID (public client, PKCE; no client secret is used anywhere).
# Register http://localhost:8501/ as a "Mobile and desktop applications" redirect URI.
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Leave empty to default to https://login.microsoftonline.com/<ENTRA_TENANT_ID>
ENTRA_AUTHORITY=

# PEP Plane A base URL (stack output PlaneAUrl). Plane B (8081) is never used by this app.
# A self-signed ALB certificate needs PEP_CA_BUNDLE (a shell environment variable, not a .env key)
# pointing at that certificate, e.g. export PEP_CA_BUNDLE=cert/cert.pem. It applies to the PEP call only.
PEP_PLANE_A_URL=https://pep-plane-a.internal.example.com

# Full AgentCore Runtime ARN (stack output AgentRuntimeArn). The app calls its HTTPS endpoint with your Entra
# ID token as a bearer token; no AWS credentials are needed on this machine.
BEDROCK_AGENT_ID=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/claims_copilot_agent-XXXXXXXXXX
